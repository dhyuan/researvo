# Use the Neon pooled endpoint for application traffic (`-pooler` in the hostname).
DATABASE_URL="postgresql://postgres:password@ep-example-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"
# Use the direct endpoint for Prisma migrations and other session-dependent operations.
DIRECT_URL="postgresql://postgres:password@ep-example.us-east-1.aws.neon.tech/neondb?sslmode=require"
FEEDBACK_ADMIN_TOKEN=""
ADMIN_WEB_PUSH_ENABLED="false"
WEB_PUSH_VAPID_PUBLIC_KEY=""
WEB_PUSH_VAPID_PRIVATE_KEY=""
WEB_PUSH_VAPID_SUBJECT="mailto:admin@example.com"
PUSH_DISPATCH_SECRET=""
AI_DEFAULT_BASE_URL="http://localhost:11434/v1"
AI_DEFAULT_MODEL="llama3.1"
